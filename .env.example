# Copie este arquivo para .env e ajuste ao hardware local.
API_PORT=8000
CPU_LIMIT=8

# WHISPER_THREADS acompanha CPU_LIMIT quando não for definido.
WHISPER_MODEL_NAME=medium
# Opcional. Por padrão, o caminho é /models/<WHISPER_MODEL_NAME>.
# WHISPER_MODEL_PATH=/models/medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
JOB_CONCURRENCY=1

# Ajuste estes valores para que arquivos gerados pertençam ao usuário do host.
LOCAL_UID=1000
LOCAL_GID=1000

# Credenciais locais de exemplo; substitua antes de qualquer implantação compartilhada.
POSTGRES_DB=whisper
POSTGRES_USER=whisper
POSTGRES_PASSWORD=local-placeholder-only

# Bucket S3 privado da aplicação. O Compose local cria o bucket e um usuário
# limitado aos objetos desse bucket, sem acesso público.
S3_BUCKET=whisper-temporary
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=whisper-app
S3_SECRET_ACCESS_KEY=local-s3-placeholder-only
MINIO_ROOT_USER=whisper-local-root
MINIO_ROOT_PASSWORD=local-minio-root-placeholder
MINIO_API_PORT=9000

# Obrigatória para a API guardar URLs assinadas cifradas no PostgreSQL.
# Gere com `openssl rand -hex 32` e mantenha SOURCE_URL_ENCRYPTION_KEY somente em .env.

# Obrigatória para provisionar e entregar webhooks; mantenha fora do repositório.
# Gere com `openssl rand -hex 32` e configure WEBHOOK_SECRET_ENCRYPTION_KEY somente em .env.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Banco de integração isolado, com porta e volume persistente próprios.
TEST_POSTGRES_DB=whisper_test
TEST_POSTGRES_USER=whisper_test
TEST_POSTGRES_PASSWORD=local-test-only
TEST_POSTGRES_PORT=55432
TEST_DATABASE_HOST=127.0.0.1
