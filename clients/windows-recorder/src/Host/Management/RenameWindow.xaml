<ui:FluentWindow x:Class="Whisper.Recorder.Host.Management.RenameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Renomear a gravação" Width="480" Height="270" ResizeMode="NoResize"
                 Icon="pack://application:,,,/WhisperRecorder;component/Assets/icon.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Whisper: renomear" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/WhisperRecorder;component/Assets/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <TextBlock Text="Título da gravação" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TitleBox" MaxLength="200" AutomationProperties.Name="Título da gravação" />
            <TextBlock Margin="0,8,0,16" Opacity="0.8" TextWrapping="Wrap"
                       Text="Deixe em branco para voltar ao título padrão: a data e a hora da gravação." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Salvar" Appearance="Primary" IsDefault="True" Margin="0,0,8,0" Click="OnSave"
                           AutomationProperties.Name="Salvar o título, atalho Enter" />
                <ui:Button Content="Cancelar" IsCancel="True"
                           AutomationProperties.Name="Cancelar sem alterar, atalho Esc" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
