<ui:FluentWindow x:Class="Whisper.Recorder.Host.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:host="clr-namespace:Whisper.Recorder.Host"
                 Title="Whisper" Width="960" Height="720" MinWidth="720" MinHeight="560"
                 Icon="pack://application:,,,/WhisperRecorder;component/Assets/icon.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <host:NullToVisibilityConverter x:Key="NullToVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Whisper: gravador de reuniões">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/WhisperRecorder;component/Assets/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,24">
                <ui:Button Content="Configurações" HorizontalAlignment="Right" Margin="0,0,0,8"
                           Click="OnOpenSettings" AutomationProperties.Name="Abrir as configurações do acesso à API" />
                <!-- Fontes e nível antes de gravar -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Fontes de áudio" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Microfone" Margin="0,0,0,12"
                              IsChecked="{Binding UseMicrophone, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSources}"
                              AutomationProperties.Name="Gravar o microfone" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Microphones}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSources}"
                              AutomationProperties.Name="Dispositivo do microfone" />
                    <ProgressBar Grid.Row="0" Grid.Column="2" Margin="0,0,12,12" Height="10" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1" Value="{Binding MicrophoneLevel, Mode=OneWay}"
                                 AutomationProperties.Name="Nível do microfone" />
                    <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,0,12"
                               Text="{Binding MicrophoneStatus}" />

                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Áudio do sistema"
                              IsChecked="{Binding UseSystemAudio, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSources}"
                              AutomationProperties.Name="Gravar o áudio do sistema" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SystemOutputs}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSystemOutput, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSources}"
                              AutomationProperties.Name="Dispositivo de saída do áudio do sistema" />
                    <ProgressBar Grid.Row="1" Grid.Column="2" Margin="0,0,12,0" Height="10" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1" Value="{Binding SystemLevel, Mode=OneWay}"
                                 AutomationProperties.Name="Nível do áudio do sistema" />
                    <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"
                               Text="{Binding SystemStatus}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Opacity="0.8"
                               TextWrapping="Wrap" Text="{Binding ActiveDeviceNote}"
                               Visibility="{Binding ActiveDeviceNote, Converter={StaticResource NullToVisibility}}" />
                </Grid>

                <!-- Windows negou o microfone -->
                <ui:InfoBar Title="Microfone sem acesso" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding MicrophoneDenied, Mode=OneWay}"
                            Message="{Binding MicrophoneDeniedHelp}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding MicrophoneDenied, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Tentar de novo" Command="{Binding RetryMicrophone}" Margin="0,0,8,0" />
                    <Button Content="Gravar só o áudio do sistema" Command="{Binding SystemOnly}" />
                </StackPanel>

                <!-- Contador e controles -->
                <Border Padding="20" CornerRadius="8" Margin="0,8,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="20" Text="{Binding StateGlyph}" Margin="0,0,8,0" />
                            <TextBlock FontSize="20" Text="{Binding StateText}" />
                        </StackPanel>
                        <TextBlock FontSize="48" FontWeight="SemiBold" Margin="0,4,0,12"
                                   Text="{Binding DurationText}"
                                   AutomationProperties.Name="Tempo gravado"
                                   AutomationProperties.LiveSetting="Off" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Gravar" Appearance="Primary" Command="{Binding Start}" Margin="0,0,8,0"
                                       AutomationProperties.Name="Iniciar gravação" />
                            <ui:Button Content="{Binding PauseResumeText}" Command="{Binding PauseResume}" Margin="0,0,8,0" />
                            <ui:Button Content="Parar e salvar" Command="{Binding Stop}" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyHint" Margin="0,12,0,0" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <ui:InfoBar Title="Aviso sobre gravação" Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding IsRecording, Mode=OneWay}"
                            Message="{Binding ThirdPartyNotice}" />
                <ui:InfoBar Title="Atenção" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding HasWarning, Mode=OneWay}"
                            Message="{Binding WarningText}" />
                <ui:InfoBar Title="Dispositivo indisponível" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding HasPreviewError, Mode=OneWay}"
                            Message="{Binding PreviewError}" />
                <ui:InfoBar Title="Não foi possível gravar" Severity="Error" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Message="{Binding Error}" />

                <!-- Lista de gravações -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Gravações" Margin="0,12,0,8" />
                <TextBlock Text="{Binding EmptyListText}" Margin="0,0,0,8"
                           Visibility="{Binding EmptyListText, Converter={StaticResource NullToVisibility}}" />
                <ListView x:Name="RecordingList" ItemsSource="{Binding Recordings}" MinHeight="140" MaxHeight="360"
                          SelectionMode="Single" SelectionChanged="OnRecordingSelected"
                          KeyDown="OnRecordingActivated" MouseDoubleClick="OnRecordingActivated"
                          AutomationProperties.Name="Lista de gravações"
                          KeyboardNavigation.TabNavigation="Once">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Situação" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusGlyph}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Status}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Título" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="280">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <!-- Explicação do acompanhamento: falha, resultado expirado ou "sem conexão" (não é falha) -->
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Data" Width="150" DisplayMemberBinding="{Binding CreatedAt}" />
                            <GridViewColumn Header="Duração" Width="90" DisplayMemberBinding="{Binding Duration}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Gestão: reproduzir, renomear e apagar a gravação selecionada (comandos e atalhos do ViewModel) -->
                <StackPanel x:Name="ManageArea" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="▶ Reproduzir" Command="{Binding Play}" ToolTip="Ctrl+P"
                                   AutomationProperties.Name="Reproduzir a gravação selecionada, atalho Ctrl+P" />
                        <ui:Button Content="Renomear" Command="{Binding Rename}" Margin="8,0,0,0" ToolTip="F2 (com a lista em foco)"
                                   AutomationProperties.Name="Renomear a gravação selecionada, atalho F2" />
                        <ui:Button Content="Apagar" Command="{Binding Delete}" Margin="8,0,0,0" ToolTip="Delete (com a lista em foco)"
                                   AutomationProperties.Name="Apagar a gravação selecionada do PC, atalho Delete" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" Text="{Binding Hint}"
                               Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Message}"
                               Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}"
                               AutomationProperties.Name="Resultado da última ação sobre as gravações"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- Envio para transcrição: nada sai sem a confirmação explícita -->
                <StackPanel x:Name="UploadArea" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{Binding TranscribeText}" Appearance="Primary" Command="{Binding Transcribe}"
                                   AutomationProperties.Name="Enviar a gravação selecionada para transcrição" />
                        <ui:Button Content="Abrir transcrição" Command="{Binding OpenTranscript}" Margin="8,0,0,0"
                                   ToolTip="Lê a transcrição guardada no PC (Enter na gravação transcrita)"
                                   AutomationProperties.Name="Abrir a transcrição da gravação selecionada" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"
                                   Text="Selecione uma gravação na lista para enviá-la ou, se já transcrita, para ler a transcrição." />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Hint}"
                               Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                    <Border Padding="20" CornerRadius="8" Margin="0,12,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Heading}" />
                            <TextBlock Text="{Binding ConfirmationTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConfirmationDuration}" />
                            <TextBlock Text="{Binding ConfirmationSize}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Notice}"
                                       Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding AsksExistingConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Text="{Binding ExistingNotice}" />
                                <CheckBox Content="Enviar de novo mesmo assim" Margin="0,4,0,0"
                                          IsChecked="{Binding ExistingTranscriptionConfirmed, Mode=TwoWay}"
                                          AutomationProperties.Name="Confirmar o reenvio de uma gravação já transcrita" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Height="10" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                             AutomationProperties.Name="Progresso do envio" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding ProgressText}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ResultMessage}"
                                       Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}" />
                            <ui:InfoBar Title="Gravação enviada" Severity="Success" IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="{Binding IsAccepted, Mode=OneWay}"
                                        Message="{Binding ResultMessage}" />
                            <ui:InfoBar Title="Envio não concluído" Severity="Error" IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="{Binding IsFailed, Mode=OneWay}"
                                        Message="{Binding ResultMessage}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button Content="Enviar para transcrição" Appearance="Primary" Command="{Binding Confirm}" Margin="0,0,8,0"
                                           Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.Name="Confirmar e enviar a gravação" />
                                <ui:Button Content="Tentar de novo" Appearance="Primary" Command="{Binding Retry}" Margin="0,0,8,0"
                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Abrir configurações" Command="{Binding OpenSettings}" Margin="0,0,8,0"
                                           Visibility="{Binding NeedsSettings, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Cancelar" Command="{Binding Cancel}" Margin="0,0,8,0"
                                           Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Fechar" Command="{Binding Dismiss}"
                                           Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
